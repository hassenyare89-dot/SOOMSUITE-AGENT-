# =============================================================================
# SAMIIR + FATMA — development environment template.
# Run `python scripts/bootstrap_dev.py` to create `.env` with freshly generated random
# values for every secret below. NEVER commit `.env` or `.secrets/`.
# In staging/production these values come from the secret manager (Vault / AWS Secrets
# Manager / Kubernetes secrets via CSI) and are referenced as vault://, aws-sm:// or file://.
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------------------
POSTGRES_DB=platform
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner (runs migrations only).
DB_OWNER_PASSWORD=
# One login per service role (least privilege; see packages/database migration 0002).
DB_PASSWORD_SVC_GATEWAY_ADMIN=
DB_PASSWORD_SVC_SAMIIR=
DB_PASSWORD_SVC_CRM=
DB_PASSWORD_SVC_SCHEDULING=
DB_PASSWORD_SVC_KNOWLEDGE=
DB_PASSWORD_SVC_NOTIFICATIONS=
DB_PASSWORD_SVC_WHATSAPP=
DB_PASSWORD_SVC_FATMA=
DB_PASSWORD_SVC_SECURITY_INGEST=
DB_PASSWORD_SVC_SCANNER_CONTROLLER=
DB_PASSWORD_SVC_APPROVALS=
DB_PASSWORD_SVC_AUDIT=
TEMPORAL_DB_PASSWORD=

# --- Redis --------------------------------------------------------------------------
REDIS_PASSWORD=

# --- Cryptographic material (base64 / JSON; generated) -------------------------------
FIELD_ENCRYPTION_KEYRING=
BLIND_INDEX_KEY=
SLOT_TOKEN_KEY=
CSRF_KEY=
QUARANTINE_KEY=
PSEUDONYM_KEY=
INGEST_DEMO_SECRET=

# --- Model providers (optional; without keys both agents run deterministic runtimes) --
SAMIIR_OPENAI_API_KEY=
FATMA_OPENAI_API_KEY=
SAMIIR_OPENAI_MODEL=gpt-5.4-mini
FATMA_OPENAI_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small

# --- Meta WhatsApp Business Cloud API -------------------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Per-tenant access tokens are referenced from the `integrations` table (secret_ref).

# --- SSO (admin console) — any OIDC provider (Entra ID, Okta, Auth0, Keycloak, Google) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_REDIRECT_URI=http://localhost:3000/api/admin/auth/callback
# Development only: seeded-user login. Refused by the gateway outside development.
DEV_LOGIN_ENABLED=true

# --- Email --------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=SAMIIR <no-reply@example.com>

# --- Web ----------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DEV_LOGIN=true

# --- Observability ------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SIEM_WEBHOOK_URL=
